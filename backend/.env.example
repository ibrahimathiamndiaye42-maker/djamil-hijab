# --- Base de données (PostgreSQL) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/djamil_hijab
# --- Sécurité : générer avec  python -c "import secrets;print(secrets.token_hex(32))" ---
SECRET_KEY=change-me
JWT_EXPIRES_MIN=480
# --- CORS : URL du frontend (séparées par des virgules) ---
CORS_ORIGINS=http://localhost:5173
# --- Environnement : development | production ---
APP_ENV=development
# --- Stockage des fichiers : local (dev) | s3 (production, compatible R2 / Supabase / S3) ---
STORAGE_BACKEND=local
UPLOAD_DIR=uploads
S3_BUCKET=
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto
S3_PUBLIC_BASE_URL=
